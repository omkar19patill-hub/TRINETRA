# TRINETRA frontend environment
#
# Copy to .env.local for local overrides. Never commit real .env files.

# Base URL the frontend calls for backend APIs.
#
# Leave unset (or set to /api) in development: the Vite dev server proxies /api
# to the backend at http://127.0.0.1:8000 and strips the /api prefix, because
# the backend serves its routes at the root (e.g. /risk/calculate).
#
# In production, point this at the backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=/api
